# Optional runtime settings. Copy to .env for local Docker Compose use.

FUND_ESTIMATOR_FORCE_MOCK=0
FUND_ESTIMATOR_ALLOW_MOCK_FALLBACK=0
FUND_ESTIMATOR_BACKGROUND_SCAN=0
FUND_ESTIMATOR_LOF_NOTICE_SCHEDULER=1

# Set this to enable the fund compare AI configuration page.
# Never commit your real password or API key.
FUND_ESTIMATOR_COMPARE_AI_PASSWORD=

# Separate password for the AI consultation page. It does not grant access to
# the fund compare AI configuration page. The consultation reuses that page's
# server-side OpenAI-compatible model configuration.
FUND_ESTIMATOR_AI_CHAT_PASSWORD=
FUND_ESTIMATOR_AI_TRANSCRIPTION_MODEL=whisper-1

# LOF notification defaults. Feishu credentials are created by the web QR flow
# and saved in the runtime data directory, not in this file.
LOF_NOTICE_ENABLED=1
LOF_NOTICE_DAILY_SUMMARY_TIME=10:00
LOF_NOTICE_SEND_EMPTY_DAILY_SUMMARY=1
LOF_FEISHU_TIMEOUT_SECONDS=30

[Unit]
Description=Fund estimator LOF premium monitor worker
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/fund-estimator
TimeoutStartSec=300
ExecStart=/usr/bin/docker compose exec -T fund-tools python -m fund_estimator.lof_worker scan --notify

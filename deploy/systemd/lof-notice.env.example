# Copy to /etc/fund-estimator/lof-notice.env on Linux/Armbian.

LOF_NOTICE_ENABLED=1
LOF_NOTICE_DAILY_SUMMARY_TIME=10:00
LOF_NOTICE_SEND_EMPTY_DAILY_SUMMARY=1
LOF_FEISHU_TIMEOUT_SECONDS=30

# Feishu bot credentials are created by the web page QR onboarding flow.
# Open the monitor page and click "接入飞书"; do not put App Secret here.
